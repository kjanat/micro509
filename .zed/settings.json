// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"formatter": [
		{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
		{ "language_server": { "name": "dprint" } }
	],
	"prettier": { "allowed": false },
	"file_types": { "JSON": [".stackblitzrc"] },
	"wrap_guides": [100],
	"languages": {
		"TypeScript": {
			"format_on_save": "on",
			"formatter": [
				{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
				{ "language_server": { "name": "dprint" } }
			],
			"language_servers": ["typescript", "deno", "biome", "..."],
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Markdown": { "wrap_guides": [80] },
		"TOML": { "wrap_guides": [140] }
	},
	"lsp": {
		"biome": {
			"binary": {
				"path": "./node_modules/.bin/biome",
				"arguments": ["lsp-proxy"]
			},
			"settings": {
				"config_path": "./biome.json",
				"require_config_file": true,
				"goto_definition": true,
				"inline_config": {
					"formatter": { "enabled": false },
					"linter": {}
				}
			}
		},
		"deno": {
			"settings": {
				"deno": {
					"enable": true,
					"enablePaths": ["./src", "./scripts", "./site"],
					"importMap": "./deno.import_map.json"
				}
			}
		},
		"json-language-server": {
			"settings": {
				"json": {
					"schemas": [
						{
							"fileMatch": ["src/internal/asn1/oids.json"],
							"url": "./src/internal/asn1/oids.schema.json"
						},
						{
							"fileMatch": [".stackblitzrc"],
							"url": "https://www.schemastore.org/stackblitzrc.json"
						}
					]
				}
			}
		},
		"vtsls": {
			"settings": {
				"typescript": { "tsdk": "./node_modules/typescript/lib/" }
			}
		},
		"dprint": {
			"binary": {
				"path": "./node_modules/.bin/dprint",
				"arguments": ["lsp"]
			}
		},
		"typescript": {}
	}
}
