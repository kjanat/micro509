{
	"$schema": "https://www.schemastore.org/tsconfig.json",
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ESNext", "DOM"],
		"types": ["*"],
		"skipLibCheck": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"composite": true,
		"outDir": "./node_modules/.cache/tsc/other",
		"tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.other.tsbuildinfo",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedDeclarations": false,
		"allowJs": true,
		"checkJs": true,
		"paths": {
			"micro509": ["./src/index.ts"]
		}
	},
	"include": [
		".config",
		"src",
		"src/**/*.json",
		"test/**/*.ts",
		"scripts",
		"packages/**/*.ts",
		"*.config.ts",
		"*.d.ts",
		"*.json",
		"*.mjs"
	],
	"exclude": ["./dist", "./node_modules", "./site", "./**/*.deno.ts"]
}
