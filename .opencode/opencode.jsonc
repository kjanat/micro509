{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.6-sol",
	"autoupdate": true,
	"formatter": {
		"kprint": {
			"command": ["node_modules/.bin/kfmt", "$FILE"],
			"extensions": [
				".sh",
				".bash",
				".toml",
				".svg",
				".json",
				".jsonc",
				".md",
				".ts",
				".mts",
				".cts",
				".js",
				".mjs",
				".cjs",
				".yml",
				".yaml",
				".py"
			]
		}
	}
}
