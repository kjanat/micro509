{
	"useTabs": true,
	"indentWidth": 2,
	"lineWidth": 100,
	"newLineKind": "lf",
	"typescript": {
		"quoteStyle": "alwaysSingle",
		"associations": ["!**/*.*{ts,js}"],
		"lineWidth": 100,
		"useTabs": true,
		"module.sortImportDeclarations": "maintain",
		"module.sortExportDeclarations": "maintain",
		"exportDeclaration.sortNamedExports": "maintain",
		"exportDeclaration.sortTypeOnlyExports": "none",
		"importDeclaration.sortNamedImports": "maintain",
		"importDeclaration.sortTypeOnlyImports": "none",
		"overrides": [{ "files": ["site/**"], "lineWidth": 60, "useTabs": false }]
	},
	"json": {
		"jsonTrailingCommaFiles": [
			"!biome.jsonc",
			"**/.vscode/*.json",
			"**/.zed/*.json",
			"**/tsconfig*.json"
		],
		"associations": [".stackblitzrc"]
	},
	"shfmt": {
		"useTabs": true,
		"binaryNextLine": true,
		"switchCaseIndent": true
	},
	"markdown": {
		"textWrap": "maintain",
		"lineWidth": 80,
		"codeBlock.useTabs": false,
		"codeBlock.preserveIndentation": false,
		"html.useTabs": false
	},
	"markup": {
		"printWidth": 120,
		"html.void.selfClosing": false,
		"formatComments": true,
		"scriptIndent": true,
		"styleIndent": true,
		"doctypeKeywordCase": "upper",
		"strictSvelteAttr": false,
		"svelteAttrShorthand": true,
		"svelteDirectiveShorthand": true,
		"ignoreCommentDirective": "dprint-ignore",
		"ignoreFileCommentDirective": "dprint-ignore-file",
		"scriptFormatter": "biome",
		"associations": ["!**/*.svg", "!**/*.vue"]
	},
	"yaml": {
		"printWidth": 160
	},
	"biome": {
		"lineEnding": "lf",
		"indentWidth": 2,
		"indentStyle": "tab",
		"lineWidth": 100,
		"semicolons": "always",
		"quoteStyle": "single",
		"jsxQuoteStyle": "double",
		"quoteProperties": "asNeeded",
		"trailingCommas": "all",
		"arrowParentheses": "always",
		"bracketSpacing": true,
		"javascript.bracketSpacing": true,
		"graphql.bracketSpacing": true,
		"bracketSameLine": true,
		"css.enabled": true,
		"graphql.enabled": true,
		"css.indentWidth": 2,
		"css.indentStyle": "tab",
		"css.lineWidth": 100,
		"javascript.indentWidth": 2,
		"javascript.indentStyle": "tab",
		"javascript.lineWidth": 100,
		"json.indentWidth": 2,
		"json.indentStyle": "tab",
		"json.lineWidth": 100
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "node_modules/.bin/tombi format - --stdin-filename {{file_path}}",
				"exts": ["toml"],
				"cacheKeyFiles": ["tombi.toml"],
				"setupCommand": "bun install"
			},
			{
				"cwd": "tsc/bridge",
				"command": "gofmt -s",
				"exts": ["go"]
			}
		]
	},
	"excludes": [
		"**/.claude/",
		"**/.venv",
		"**/*-lock.json",
		"**/node_modules",
		"**/worker-configuration.d.ts",
		"**/bun.lock",
		"**/dist",
		"**/docs/deno",
		"**/docs/{itu,rfc}",
		"**/docs/w3c/**/*.txt",
		"examples/vite/src/favicon.svg"
	],
	"plugins": [
		"https://plugins.dprint.dev/kjanat/shfmt-1.1.1.wasm",
		"https://plugins.dprint.dev/kjanat/sortpackagejson-0.2.1.wasm",
		"https://plugins.dprint.dev/kjanat/svg-v0.4.1.wasm",
		"node_modules/@dprint/biome/plugin.wasm",
		"node_modules/dprint-plugin-malva/plugin.wasm",
		"node_modules/@dprint/json/plugin.wasm",
		"node_modules/@dprint/markdown/plugin.wasm",
		"node_modules/@dprint/typescript/plugin.wasm",
		"node_modules/dprint-plugin-markup/plugin.wasm",
		"node_modules/dprint-plugin-yaml/plugin.wasm",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"
	]
}
