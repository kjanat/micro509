{
	"name": "micro509-site",
	"version": "",
	"private": true,
	"type": "module",
	"imports": {
		"#*": "./*",
		"#components/*": "./theme/components/*"
	},
	"scripts": {
		"build": "vitepress build ..",
		"deploy": "wrangler deploy",
		"deploy:version": "wrangler versions upload",
		"dev": "vitepress dev .. --host",
		"fmt": "run --dir=.. dprint fmt",
		"preview": "vitepress preview ..",
		"test": "bun test live-code.test.ts",
		"typecheck": "bun typecheck.ts",
		"wrangler:types": "wrangler types"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "catalog:cloudflare",
		"@kjanat/tsc-bridge": "workspace:*",
		"@kjanat/tsc-vue-mapper": "workspace:*",
		"@micro509/vitepress-api-docs": "workspace:*",
		"@micro509/vitepress-doc-examples": "workspace:*",
		"@micro509/vitepress-github-links": "workspace:*",
		"@micro509/vitepress-versioned-docs": "workspace:*",
		"@tsconfig/node24": "catalog:ts",
		"@types/bun": "catalog:ts",
		"@types/node": "catalog:ts",
		"@vue/tsconfig": "catalog:ts",
		"dprint": "catalog:",
		"importmapify": "catalog:deno",
		"markdown-it-task-lists": "catalog:site",
		"micro509": "workspace:*",
		"runner-run": "catalog:",
		"typescript": "catalog:ts7",
		"vite-robots-txt": "catalog:site",
		"vite-svg-to-ico": "catalog:site",
		"vitepress": "catalog:site",
		"vue": "catalog:",
		"wrangler": "catalog:cloudflare"
	}
