{
	"$schema": "https://www.schemastore.org/tsconfig.json",
	"extends": ["@tsconfig/node24/tsconfig.json", "@vue/tsconfig", "@vue/tsconfig/tsconfig.dom.json"],
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "bun"]
	},
	"exclude": ["./dist/", "./cache/"],
	"contentMappers": [
		{
			"package": "@kjanat/tsc-vue-mapper",
			"extensions": [".vue"]
		}
	]
}
