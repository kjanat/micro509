{
	"name": "@kjanat/tsc-vue-mapper",
	"version": "0.0.0",
	"description": "TypeScript content mapper that type-checks Vue single-file components with the native compiler.",
	"type": "module",
	"imports": {
		"#vue-mapper": "./src/index.ts",
		"#*": "./src/*.ts"
	},
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"bin": "server.ts",
	"files": ["/server.ts", "/src/"],
	"scripts": {
		"test": "bun test"
	},
	"dependencies": {
		"@kjanat/tsc-compat": "workspace:*",
		"@vue/language-core": "catalog:ts"
	},
	"devDependencies": {
		"@kjanat/tsc-bridge": "workspace:*",
		"@kjanat/tsc-wasm": "workspace:*",
		"@volar/typescript": "catalog:ts"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"engineStrict": true,
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		},
		"runtime": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		}
	},
	"tscBridge": {
		"verify": true,
		"module": "./src/index.ts"
	},
	"typescript": {
		"contentMapper": {
			"exec": ["bun", "server.ts"],
			"compilerOptions": [],
			"dynamicConfig": false
		}
	}
}
