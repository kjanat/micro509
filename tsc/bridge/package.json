{
	"name": "@kjanat/tsc-bridge",
	"version": "0.0.0",
	"private": true,
	"description": "Experimental JS access to the native TypeScript compiler.",
	"type": "module",
	"imports": {
		"#bridge": "./index.ts"
	},
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "go build -p 2 -trimpath -o bin/tsc-bridge .",
		"test": "run -s test:go test:js",
		"test:go": "go vet ./...",
		"test:js": "bun test"
	},
	"dependencies": {
		"@kjanat/tsc-protocol": "workspace:*"
	},
	"devDependencies": {
		"runner-run": "catalog:"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"engineStrict": true,
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		},
		"runtime": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		}
	}
}
