{
	"name": "@kjanat/tsc-wasm",
	"version": "0.0.0",
	"private": true,
	"description": "Experimental in-process WebAssembly version of the TypeScript Go bridge.",
	"type": "module",
	"imports": {
		"#wasm": "./index.ts"
	},
	"exports": {
		".": "./index.ts",
		"./package.json": "./package.json"
	},
	"files": ["/bin/", "/host.ts", "/index.ts"],
	"scripts": {
		"build": "bun build.ts",
		"test": "bun probe.ts"
	},
	"dependencies": {
		"@kjanat/tsc-protocol": "workspace:*"
	},
	"devDependencies": {
		"@kjanat/tsc-bridge": "workspace:*"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"engineStrict": true,
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		},
		"runtime": {
			"name": "bun",
			"version": ">=1.4.2",
			"onFail": "error"
		}
	}
}
