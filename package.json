{
	"name": "micro509",
	"version": "0.7.2",
	"description": "The zero-dependency TypeScript PKI toolkit for real certificate workflows.",
	"keywords": [
		"x509",
		"certificate",
		"csr",
		"pem",
		"der",
		"jwk"
	],
	"homepage": "https://micro509.kjanat.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/micro509.git"
	},
	"license": "MIT",
	"author": {
		"name": "Kaj Kowalski",
		"email": "info@kajkowalski.nl",
		"url": "https://github.com/kjanat"
	},
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#micro509": "./src/index.ts",
		"#micro509/*": "./src/*",
		"#micro509/internal/*": "./src/internal/*",
		"#pkg": "./package.json",
		"#jsr": "./jsr.json",
		"#typedoc-sidebar": "./site/api/typedoc-sidebar.json"
	},
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./keys": {
			"bun": "./src/keys/index.ts",
			"default": "./dist/keys.js"
		},
		"./pem": {
			"bun": "./src/pem/index.ts",
			"default": "./dist/pem.js"
		},
		"./pkcs": {
			"bun": "./src/pkcs/index.ts",
			"default": "./dist/pkcs.js"
		},
		"./result": {
			"bun": "./src/result/index.ts",
			"default": "./dist/result.js"
		},
		"./revocation": {
			"bun": "./src/revocation/index.ts",
			"default": "./dist/revocation.js"
		},
		"./verify": {
			"bun": "./src/verify/index.ts",
			"default": "./dist/verify.js"
		},
		"./x509": {
			"bun": "./src/x509/index.ts",
			"default": "./dist/x509.js"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"workspaces": [
		"site/.vitepress"
	],
	"scripts": {
		"bd": "tsdown --no-attw --no-publint --no-unused --no-report",
		"build": "tsdown",
		"check": "run -pK check:biome check:deno typecheck",
		"check:biome": "biome check",
		"check:deno": "deno check src",
		"docs:build": "run -pk deno:importsmap deno:cleandocs; deno doc --no-npm --import-map deno.import_map.json --html --output=docs/deno --name=micro509 src/**/index.ts",
		"docs:lint": "run -pk deno:importsmap deno:cleandocs; deno doc --no-npm --import-map deno.import_map.json --html --output=docs/deno --name=micro509 --lint src/**/index.ts",
		"deno:importsmap": "jq '{ imports: (.imports | with_entries(.key |= sub(\"/[*]$\"; \"/\") | .value |= if type == \"string\" then sub(\"/[*]$\"; \"/\") else . end)) }' package.json > deno.import_map.json",
		"deno:cleandocs": "rm -rf docs/deno 2>/dev/null",
		"fmt": "dprint fmt",
		"lint": "bun lint:biome",
		"lint:biome": "biome lint",
		"lint:deno": "bun --silent deno:importsmap; deno lint src",
		"playwright:chromium": "npx playwright install --with-deps chromium",
		"prepublishOnly": "[ -n \"${GITHUB_ACTIONS:-}\" ] || { printf '%s\\n' 'manual npm publish blocked; use release workflow for provenance' >&2; exit 1; }",
		"publish:jsr": "[ -n \"${GITHUB_ACTIONS:-}\" ] || { printf '%s\\n' 'manual JSR publish blocked; use release workflow' >&2; exit 1; }; bunx jsr publish",
		"publish:pkgprnew": "bunx pkg-pr-new publish --packageManager='npm,pnpm,bun' --bun",
		"site:api": "bun scripts/site-env.ts typedoc",
		"site:api:watch": "bun scripts/site-env.ts typedoc --watch",
		"site:build": "run -s site:api site:vitepress",
		"site:dev": "run -p site:api:watch site:vitepress:dev",
		"site:preview": "run -s site:api site:vitepress:preview",
		"site:typecheck": "bun scripts/site-env.ts vue-tsc --noEmit -p site/.vitepress/tsconfig.json",
		"site:vitepress": "bun scripts/site-env.ts vitepress build site",
		"site:vitepress:dev": "bun scripts/site-env.ts vitepress dev site --host",
		"site:vitepress:preview": "bun scripts/site-env.ts vitepress preview site",
		"smoke": "run build -l silent; run -p smoke:browser smoke:bun smoke:deno smoke:node smoke:workerd",
		"smoke:browser": "node scripts/smoke-browser.mjs",
		"smoke:bun": "bun --bun scripts/smoke.mjs",
		"smoke:deno": "deno run --allow-read scripts/smoke.mjs",
		"smoke:node": "node scripts/smoke.mjs",
		"smoke:workerd": "node scripts/smoke-workerd.mjs",
		"test": "AGENT=1 bun test --coverage --concurrent",
		"test:differential": "bun test test/differential.test.ts",
		"test:pkits": "bun test test/pkits.test.ts",
		"test:watch": "AGENT=1 bun test --watch --concurrent",
		"typecheck": "tsgo --noEmit -p tsconfig.src.json && tsgo --noEmit -p tsconfig.other.json",
		"typecheck:tsc": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.other.json",
		"wrangler:build": "wrangler build",
		"wrangler:deploy": "wrangler deploy",
		"wrangler:deploy:versions": "wrangler versions upload",
		"wrangler:dev": "wrangler dev"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.4",
		"@biomejs/biome": "^2.5.1",
		"@tsconfig/node24": "^24.0.4",
		"@types/bun": "^1.3.14",
		"@types/node": "26.0.1",
		"@typescript/native-preview": "^7.0.0-dev.20260630.1",
		"dprint": "^0.55.1",
		"oxc-minify": "^0.138.0",
		"playwright": "^1.61.1",
		"publint": "^0.3.21",
		"runner-run": "^0.16.1",
		"tsdown": "^0.22.3",
		"typescript": "^6.0.3",
		"unplugin-unused": "^0.5.7",
		"wrangler": "^4.106.0"
	},
	"packageManager": "bun@1.3.14",
	"devEngines": {
		"packageManager": [
			{
				"name": "bun",
				"onFail": "download"
			},
			{
				"name": "npm",
				"version": ">=11"
			}
		],
		"runtime": [
			{
				"name": "node",
				"version": ">=24"
			},
			{
				"name": "bun",
				"version": ">=1.3"
			},
			{
				"name": "deno"
			}
		]
	},
	"volta": {
		"node": "26.4.0",
		"npm": "11.17.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./keys": "./dist/keys.js",
			"./pem": "./dist/pem.js",
			"./pkcs": "./dist/pkcs.js",
			"./result": "./dist/result.js",
			"./revocation": "./dist/revocation.js",
			"./verify": "./dist/verify.js",
			"./x509": "./dist/x509.js",
			"./package.json": "./package.json"
		}
	},
	"typedocoptions": {
		"extends": "./config/typedoc.config.mjs"
	}
}
