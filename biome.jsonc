{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "master"
	},
	"files": {
		"includes": ["**", "!!**/dist", "!!**/*.svg"]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			// "types": "recommended", await [biomejs/biome#10885](https://github.com/biomejs/biome/issues/10885) resolution
			"test": "recommended"
		},
		"rules": {
			"complexity": {
				"recommended": true,
				"useLiteralKeys": "off",
				"noExcessiveCognitiveComplexity": {
					"options": { "maxAllowedComplexity": 30 },
					"level": "info"
				},
			},
			"correctness": { "recommended": true },
			"performance": { "recommended": true },
			"nursery": { "recommended": true },
			"security": { "recommended": true },
			"style": { "recommended": true },
			"suspicious": { "recommended": true }
		}
	},
	"javascript": {
		"formatter": { "quoteStyle": "single" }
	},
	"json": { "formatter": { "enabled": false } },
	"assist": {
		"enabled": true,
		"actions": {
			"source": { "organizeImports": "off" }
		}
	},
	"overrides": [{
		"includes": ["**/*.jsonc", "!biome.jsonc"],
		"json": { "formatter": { "trailingCommas": "all" } }
	}, {
		"includes": ["**/site"],
		"formatter": {
			"lineWidth": 60
		}
	}, {
		"includes": ["**/*.svelte", "**/*.astro", "**/*.vue"],
		"linter": {
			"rules": {
				"style": { "useConst": "off", "useImportType": "off" },
				"correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
			}
		}
	}, {
		"includes": ["site/**"],
		"formatter": { "indentStyle": "space" },
		"javascript": { "formatter": { "indentStyle": "tab" } },
		"assist": { "enabled": false }
	}, {
		"includes": ["site/.vitepress/**"],
		"formatter": { "enabled": false }
	}]
}
